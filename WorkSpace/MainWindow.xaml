<Window x:Class="ExcelToJson.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel → JSON 转换工具" Height="820" Width="1280" MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Style="{StaticResource {x:Type Window}}">
    <Grid x:Name="AppLayout" Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Excel → JSON" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="配置工作表 · 生成 JSON · 同步到项目" Style="{StaticResource HelpText}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="保存规则" Click="SaveRules_Click" Margin="0,0,16,0" Height="38"
                            IsEnabled="{Binding IsEnabled, ElementName=ConvertButton}"/>
                    <Button x:Name="ConvertButton" Content="开始转换" Click="Convert_Click" Height="38" Padding="20,5"/>
                    <Button x:Name="SyncButton" Content="一键更新并同步" Height="38" Margin="8,0,0,0" Padding="20,5"
                            Style="{StaticResource PrimaryButton}" Click="Sync_Click"
                            IsEnabled="{Binding IsEnabled, ElementName=ConvertButton}"
                            ToolTip="更新 SVN，按规则生成 JSON，仅复制开启了复制开关的工作表"/>
                    <Button x:Name="CancelSyncButton" Content="停止" Margin="8,0,0,0" Height="38" Visibility="Collapsed"
                            Click="CancelSync_Click" ToolTip="停止 SVN；解析结束后停止；复制期间停止会回滚"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270" MinWidth="230" MaxWidth="360"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="620"/></Grid.ColumnDefinitions>
            <Border x:Name="WorkbooksPanel" Background="#F1F4F8" Padding="20,24" IsEnabled="{Binding IsEnabled, ElementName=ConvertButton}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="工作簿" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ComboBox x:Name="FileCombo" SelectionChanged="FileCombo_SelectionChanged" AutomationProperties.Name="Excel 文件" ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"/>
                        <Grid Margin="0,8,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Content="添加" Padding="6,4" Click="AddFile_Click" Margin="0,0,6,0"/>
                            <Button Grid.Column="1" Content="移除" Padding="6,4" Click="RemoveFile_Click" Margin="0,0,6,0" ToolTip="仅移除文件配置"/>
                            <Button Grid.Column="2" Content="扫描" Padding="10,4" Click="ScanSheets_Click" ToolTip="扫描当前 Excel 文件中的工作表；开启自动读取时更新结束行，并保存规则"/>
                        </Grid>
                        <TextBlock Text="工作表" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"/>
                        <TextBlock Text="勾选参与生成，点击名称编辑规则" Style="{StaticResource HelpText}" Margin="0,0,0,8"/>
                    </StackPanel>
                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Content="添加工作表" Click="AddSheet_Click" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="删除" Click="RemoveSheet_Click"/>
                    </Grid>
                    <Grid>
                        <ListBox x:Name="SheetList" SelectionChanged="SheetList_SelectionChanged" BorderThickness="0"
                                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="工作表列表">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel ToolTip="{Binding Name}">
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  AutomationProperties.Name="{Binding Name, StringFormat=转换 {0}}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="暂无工作表。扫描当前文件，或添加 Sheet。" IsHitTestVisible="False" Margin="8,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource HelpText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=SheetList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource LineBrush}" ShowsPreview="True"/>
            <TabControl x:Name="WorkspaceTabs" Grid.Column="2" Background="White" Padding="0" BorderThickness="0"
                        AutomationProperties.Name="工作区导航" FontWeight="Normal">
                <TabItem x:Name="EditorPage" Header="规则编辑" Style="{StaticResource WorkspaceTab}">

                <Grid x:Name="RuleWorkspace" Margin="28,24" TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontWeight="Normal" IsEnabled="{Binding IsEnabled, ElementName=ConvertButton}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="RuleTitle" Text="工作表规则" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,24" TextTrimming="CharacterEllipsis"/>
                    <Grid x:Name="RuleEditorPanel" Grid.Row="1" IsEnabled="False">
                        <TabControl x:Name="RuleTabs" AutomationProperties.Name="规则分类">
                            <TabControl.Style>
                                <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
                                    <Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=SheetList}" Value="{x:Null}"><Setter Property="Visibility" Value="Hidden"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TabControl.Style>
                            <TabItem Header="基本设置">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Foreground="{StaticResource TextBrush}" FontWeight="Normal">
                                    <StackPanel Margin="0,4,12,0">
                                        <Grid Margin="0,0,0,8">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="90"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="90"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="输出文件" VerticalAlignment="Center"/>
    <TextBox x:Name="OutputNameBox" AutomationProperties.Name="输出文件" Grid.Column="1" Height="32" Margin="0,0,20,12"/>
    <TextBlock Grid.Column="2" Text="主键字段" VerticalAlignment="Center"/>
    <TextBox x:Name="KeyColumnBox" AutomationProperties.Name="主键字段" Grid.Column="3" Height="32" Margin="0,0,0,12"/>

    <TextBlock Grid.Row="1" Text="起始行" VerticalAlignment="Center"/>
    <TextBox x:Name="RowStartBox" AutomationProperties.Name="起始行" Grid.Row="1" Grid.Column="1" Height="32" Margin="0,0,20,12"/>
    <TextBlock Grid.Row="1" Grid.Column="2" Text="结束行" VerticalAlignment="Center"/>
    <TextBox x:Name="RowEndBox" AutomationProperties.Name="结束行" Grid.Row="1" Grid.Column="3" Height="32" Margin="0,0,0,12"
             IsReadOnly="{Binding IsChecked, ElementName=AutoDetectRowsBox}"
             ToolTip="自动读取开启时显示上次扫描的结束行；关闭后可手动编辑"/>

    <TextBlock Grid.Row="2" Text="起始列" VerticalAlignment="Center"/>
    <TextBox x:Name="ColStartBox" AutomationProperties.Name="起始列" Grid.Row="2" Grid.Column="1" Height="32" Margin="0,0,20,12"/>
    <TextBlock Grid.Row="2" Grid.Column="2" Text="结束列" VerticalAlignment="Center"/>
    <TextBox x:Name="ColEndBox" AutomationProperties.Name="结束列" Grid.Row="2" Grid.Column="3" Height="32" Margin="0,0,0,12"/>

    <TextBlock Grid.Row="3" Text="跳过列" VerticalAlignment="Center"/>
    <TextBox x:Name="ExcludeColsBox" AutomationProperties.Name="跳过列" Grid.Row="3" Grid.Column="1" Height="32" Margin="0,0,20,12"
             ToolTip="逗号分隔，如 G,H"/>
    <TextBlock Grid.Row="3" Grid.Column="2" Text="数组字段" VerticalAlignment="Center"/>
    <TextBox x:Name="ArrayFieldsBox" AutomationProperties.Name="数组字段" Grid.Row="3" Grid.Column="3" Height="32" Margin="0,0,0,12"
             ToolTip="逗号分隔"/>

    <TextBlock Grid.Row="4" Text="取整字段" VerticalAlignment="Center"/>
    <TextBox x:Name="RoundFieldsBox" AutomationProperties.Name="取整字段" Grid.Row="4" Grid.Column="1" Height="32" Margin="0,0,20,12"
             ToolTip="* 表示全部，或逗号分隔字段名"/>
    <TextBlock Grid.Row="4" Grid.Column="2" Text="输出模式" VerticalAlignment="Center"/>
    <ComboBox x:Name="NoKeyModeBox" AutomationProperties.Name="输出模式" Grid.Row="4" Grid.Column="3" Height="32" Margin="0,0,0,12">
        <ComboBoxItem Content="数组 Array" Tag="Array"/>
        <ComboBoxItem Content="序号对象 RowIndexObject" Tag="RowIndexObject"/>
    </ComboBox>

    <CheckBox x:Name="RemoveEmptyBox" Grid.Row="5" Grid.Column="1"
              Content="移除空字段" Margin="0,0,0,8" VerticalAlignment="Center"/>
</Grid>
                                        <TextBlock Text="自定义字段名和计算表达式，请切换到「字段映射」。" Style="{StaticResource HelpText}" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="字段映射">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Foreground="{StaticResource TextBrush}" FontWeight="Normal">
                                    <StackPanel Margin="0,4,12,0">
                                        <TextBlock Text="表头映射（列字母 → 字段名）" FontWeight="SemiBold" Margin="0,4,0,4"/>
<DataGrid x:Name="HeadersGrid" AutomationProperties.Name="表头映射"
          AutoGenerateColumns="False"
          CanUserAddRows="True"
          CanUserDeleteRows="True"
          Height="200"
          Margin="0,0,0,8"
          HeadersVisibility="Column">
    <DataGrid.Columns>
        <DataGridTextColumn Header="列字母" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
        <DataGridTextColumn Header="字段名" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
    </DataGrid.Columns>
</DataGrid>

<TextBlock Text="计算列（字段名 → 表达式）" FontWeight="SemiBold" Margin="0,4,0,4"/>
<TextBlock Text="示例: spiritType * 100 + level" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,4"/>
<DataGrid x:Name="ComputedGrid" AutomationProperties.Name="计算列"
          AutoGenerateColumns="False"
          CanUserAddRows="True"
          CanUserDeleteRows="True"
          Height="130"
          Margin="0,0,0,8"
          HeadersVisibility="Column">
    <DataGrid.Columns>
        <DataGridTextColumn Header="字段名" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
        <DataGridTextColumn Header="表达式" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
    </DataGrid.Columns>
</DataGrid>
                                        <TextBlock Text="在表格末行添加项目，选中行后按 Delete 删除。" Style="{StaticResource HelpText}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="子表规则">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Foreground="{StaticResource TextBrush}" FontWeight="Normal">
                                    <StackPanel Margin="0,4,12,0"><TextBlock Text="选择子表后编辑其独立的输出规则。" Style="{StaticResource HelpText}" Margin="0,0,0,12"/>
<DockPanel Margin="0,0,0,12">
    <StackPanel DockPanel.Dock="Right" Orientation="Vertical" Margin="12,0,0,0">
        <Button Content="添加子表" Height="32" Padding="8,0" Click="AddSubTable_Click"/>
        <Button Content="删除子表" Height="32" Padding="8,0" Margin="0,8,0,0" Click="RemoveSubTable_Click"/>
    </StackPanel>
    <ListBox x:Name="SubTableList" Height="80" SelectionChanged="SubTableList_SelectionChanged"/>
</DockPanel>

<Border x:Name="SubTableEditor" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
        Padding="0,16,0,0" IsEnabled="False">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="子表 Key" VerticalAlignment="Center"/>
            <TextBox x:Name="SubKeyBox" AutomationProperties.Name="子表 Key" Grid.Column="1" Height="32" Margin="0,0,8,4"
                     LostFocus="SubKeyBox_LostFocus"/>
            <TextBlock Grid.Column="2" Text="输出文件" VerticalAlignment="Center"/>
            <TextBox x:Name="SubOutputBox" AutomationProperties.Name="子表输出文件" Grid.Column="3" Height="32" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="1" Text="行起/止" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,4">
                <TextBox x:Name="SubRowStartBox" AutomationProperties.Name="子表起始行" Width="64" Height="32"/>
                <TextBlock Text=" - " VerticalAlignment="Center"/>
                <TextBox x:Name="SubRowEndBox" AutomationProperties.Name="子表结束行" Width="64" Height="32"
                         IsReadOnly="{Binding IsChecked, ElementName=AutoDetectRowsBox}"
                         ToolTip="自动读取开启时显示上次扫描的结束行；关闭后可手动编辑"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="列起/止" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBox x:Name="SubColStartBox" AutomationProperties.Name="子表起始列" Width="50" Height="32"/>
                <TextBlock Text=" - " VerticalAlignment="Center"/>
                <TextBox x:Name="SubColEndBox" AutomationProperties.Name="子表结束列" Width="50" Height="32"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="跳过列" VerticalAlignment="Center"/>
            <TextBox x:Name="SubExcludeBox" AutomationProperties.Name="子表跳过列" Grid.Row="2" Grid.Column="1" Height="32" Margin="0,0,8,4"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="数组字段" VerticalAlignment="Center"/>
            <TextBox x:Name="SubArrayBox" AutomationProperties.Name="子表数组字段" Grid.Row="2" Grid.Column="3" Height="32" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="3" Text="取整字段" VerticalAlignment="Center"/>
            <TextBox x:Name="SubRoundBox" AutomationProperties.Name="子表取整字段" Grid.Row="3" Grid.Column="1" Height="32" Margin="0,0,8,4"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Text="输出模式" VerticalAlignment="Center"/>
            <ComboBox x:Name="SubNoKeyModeBox" AutomationProperties.Name="子表输出模式" Grid.Row="3" Grid.Column="3" Height="32" Margin="0,0,0,4">
                <ComboBoxItem Content="数组 Array" Tag="Array"/>
                <ComboBoxItem Content="序号对象 RowIndexObject" Tag="RowIndexObject"/>
            </ComboBox>

            <CheckBox x:Name="SubWrapBox" Grid.Row="4" Grid.Column="1" Content="使用子表 Key 包装" Margin="0,0,0,4"/>
            <CheckBox x:Name="SubRemoveEmptyBox" Grid.Row="4" Grid.Column="3" Content="移除空字段" Margin="0,0,0,4"/>
        </Grid>

        <TextBlock Text="子表头映射" Margin="0,4,0,2"/>
        <DataGrid x:Name="SubHeadersGrid" AutomationProperties.Name="子表头映射" AutoGenerateColumns="False" CanUserAddRows="True"
                  CanUserDeleteRows="True" Height="80" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="列字母" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                <DataGridTextColumn Header="字段名" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="子表计算列" Margin="0,6,0,2"/>
        <DataGrid x:Name="SubComputedGrid" AutomationProperties.Name="子表计算列" AutoGenerateColumns="False" CanUserAddRows="True"
                  CanUserDeleteRows="True" Height="70" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="字段名" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                <DataGridTextColumn Header="表达式" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</Border></StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem x:Name="OtherSettingsTab" Header="其他配置">
                                <StackPanel Margin="0,12,12,0">
                                    <CheckBox x:Name="CopyToTargetBox" Content="复制 JSON 到 Cocos" AutomationProperties.Name="复制 JSON 到 Cocos"
                                              ToolTip="默认关闭。仅影响一键更新并同步时的目标复制，不影响 JSON 生成。"/>
                                    <TextBlock Text="默认关闭。开启后，「一键更新并同步」会将此工作表生成的 JSON 复制到 Cocos 目录。"
                                               Style="{StaticResource HelpText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                    <TextBlock Text="包含此工作表所有子表的输出；关闭时仍正常生成 JSON，但不覆盖 Cocos 中的文件。"
                                               Style="{StaticResource HelpText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </Grid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=SheetList}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="选择一个工作表" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="点击左侧 Sheet 名称，查看和编辑转换规则。勾选框决定该工作表是否参与转换。"
                                   Style="{StaticResource HelpText}" TextAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            
                </TabItem>
                <TabItem x:Name="DirectoriesPage" Header="目录与同步" Style="{StaticResource WorkspaceTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DirectorySettingsPanel" Margin="28,24" MaxWidth="920" HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding IsEnabled, ElementName=ConvertButton}" TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontWeight="Normal">
                            <TextBlock Text="目录与同步" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="设置 Excel 来源、JSON 输出位置及 Cocos 同步目标。" Style="{StaticResource HelpText}" Margin="0,8,0,28"/>
                            <TextBlock Text="转换目录" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,20"/>
<StackPanel Margin="0,0,0,24">
        <Label Content="Excel 目录" Target="{Binding ElementName=ExcelDirBox}" Padding="0" Margin="0,0,0,8"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseExcelDir_Click" Margin="8,0,0,0" MinWidth="72" Height="36" AutomationProperties.Name="浏览Excel 目录"/>
            
            <TextBox x:Name="ExcelDirBox" Height="36" AutomationProperties.Name="Excel 目录" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </DockPanel>
    </StackPanel><StackPanel Margin="0,0,0,24">
        <Label Content="JSON 输出目录" Target="{Binding ElementName=OutputDirBox}" Padding="0" Margin="0,0,0,8"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseOutputDir_Click" Margin="8,0,0,0" MinWidth="72" Height="36" AutomationProperties.Name="浏览JSON 输出目录"/>
            <Button DockPanel.Dock="Right" Content="打开目录" Click="OpenOutput_Click" Margin="8,0,0,0" Height="36"/>
            <TextBox x:Name="OutputDirBox" Height="36" AutomationProperties.Name="JSON 输出目录" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </DockPanel>
    </StackPanel>
                            <CheckBox x:Name="AutoDetectRowsBox" Content="自动读取行数，遇到空行停止" Margin="0,0,0,8"
                                      ToolTip="对所有工作表和子表生效。关闭后使用各表手动设置的结束行。"/>
                            <TextBlock Text="适用于所有工作表及子表；关闭后使用手动设置的结束行。" Style="{StaticResource HelpText}"/>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,28,0,24"/>
                            <TextBlock Text="同步到 Cocos" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="仅复制在工作表「其他配置」中开启了复制开关的 JSON，保留 .meta 和其他文件。" Style="{StaticResource HelpText}" Margin="0,0,0,20"/>
<StackPanel Margin="0,0,0,24">
        <Label Content="SVN 更新目录" Target="{Binding ElementName=SvnDirBox}" Padding="0" Margin="0,0,0,8"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseSvnDir_Click" Margin="8,0,0,0" MinWidth="72" Height="36" AutomationProperties.Name="浏览SVN 更新目录"/>
            
            <TextBox x:Name="SvnDirBox" Height="36" AutomationProperties.Name="SVN 更新目录" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </DockPanel>
    </StackPanel><StackPanel Margin="0,0,0,24">
        <Label Content="Cocos JSON 目录" Target="{Binding ElementName=TargetDirBox}" Padding="0" Margin="0,0,0,8"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseTargetDir_Click" Margin="8,0,0,0" MinWidth="72" Height="36" AutomationProperties.Name="浏览Cocos JSON 目录"/>
            
            <TextBox x:Name="TargetDirBox" Height="36" AutomationProperties.Name="Cocos JSON 目录" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </DockPanel>
    </StackPanel>
                            <Expander x:Name="SyncSettingsExpander" Header="高级设置" Margin="0,4,0,24">
                                <StackPanel Margin="0,16,0,0">
<StackPanel Margin="0,0,0,24">
        <Label Content="SVN 程序（可留空）" Target="{Binding ElementName=SvnExeBox}" Padding="0" Margin="0,0,0,8"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseSvnExe_Click" Margin="8,0,0,0" MinWidth="72" Height="36" AutomationProperties.Name="浏览SVN 程序（可留空）"/>
            
            <TextBox x:Name="SvnExeBox" Height="36" AutomationProperties.Name="SVN 程序（可留空）" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </DockPanel>
    </StackPanel>
                                    <TextBlock Text="留空使用工具附带的 svn.exe。覆盖前的备份保存在 JSON 输出目录的 .sync-runs 中。" Style="{StaticResource HelpText}"/>
                                </StackPanel>
                            </Expander>
                            <Button Content="恢复默认规则" Click="ResetRules_Click" HorizontalAlignment="Left" ToolTip="恢复内置规则，将提示确认"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="LogPage" Header="运行日志" Style="{StaticResource WorkspaceTab}">
                    <Grid Margin="28,24" TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontWeight="Normal">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="运行日志" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="查看转换、SVN 更新和复制的详细结果。" Style="{StaticResource HelpText}" Margin="0,8,0,0"/></StackPanel>
                            <Button Grid.Column="1" Content="清空日志" Click="ClearLog_Click" VerticalAlignment="Top"/>
                        </Grid>
                        <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" FontSize="13"
                                 BorderThickness="1" BorderBrush="{StaticResource LineBrush}" Background="#F8FAFC" Padding="16"
                                 FontWeight="Normal" Foreground="{StaticResource TextBrush}" VerticalContentAlignment="Top" AutomationProperties.Name="运行日志"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
                <Button Grid.Column="1" Content="查看日志" Click="ShowLog_Click" Padding="8,0" MinHeight="26" Margin="16,4,0,4"/>
            </Grid>
        </Border>
    </Grid>
</Window>
