<Window x:Class="ExcelToJson.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExcelToJson"
        mc:Ignorable="d"
        Title="Excel → JSON 转换工具"
        Height="720" Width="1140"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="280"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="160" MinHeight="100"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Excel → JSON"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#1F2937"
                   Margin="0,0,0,12"/>

        <!-- 路径 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Excel 目录" VerticalAlignment="Center" Foreground="#374151"/>
            <TextBox x:Name="ExcelDirBox" Grid.Column="1" Height="30" Padding="8,4"
                     VerticalContentAlignment="Center" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="浏览..." Width="72" Height="30" Click="BrowseExcelDir_Click"/>

            <TextBlock Grid.Row="1" Text="输出目录" VerticalAlignment="Center" Margin="0,8,0,0" Foreground="#374151"/>
            <TextBox x:Name="OutputDirBox" Grid.Row="1" Grid.Column="1" Height="30" Padding="8,4"
                     VerticalContentAlignment="Center" Margin="0,8,8,0"/>
            <Button Grid.Row="1" Grid.Column="2" Content="浏览..." Width="72" Height="30"
                    Margin="0,8,0,0" Click="BrowseOutputDir_Click"/>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="ConvertButton" Content="开始转换" Width="110" Height="34"
                        FontWeight="SemiBold" Background="#2563EB" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Click="Convert_Click"/>
                <Button Content="保存规则" Width="90" Height="34" Margin="8,0,0,0" Click="SaveRules_Click"/>
                <Button Content="恢复默认" Width="90" Height="34" Margin="8,0,0,0" Click="ResetRules_Click"/>
                <Button Content="扫描 Sheet" Width="90" Height="34" Margin="8,0,0,0" Click="ScanSheets_Click"/>
                <Button Content="打开输出目录" Width="110" Height="34" Margin="8,0,0,0" Click="OpenOutput_Click"/>
                <Button Content="清空日志" Width="80" Height="34" Margin="8,0,0,0" Click="ClearLog_Click"/>
            </StackPanel>
        </Grid>

        <!-- 规则区 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- 左：文件 + Sheet 列表 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Excel 文件 / Sheet" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox x:Name="FileCombo" Width="170" Height="28"
                                  SelectionChanged="FileCombo_SelectionChanged"/>
                        <Button Content="+" Width="28" Height="28" Margin="4,0,0,0" ToolTip="添加文件名"
                                Click="AddFile_Click"/>
                        <Button Content="-" Width="28" Height="28" Margin="4,0,0,0" ToolTip="删除文件"
                                Click="RemoveFile_Click"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="添加 Sheet" Height="28" Padding="8,0" Click="AddSheet_Click"/>
                        <Button Content="删除 Sheet" Height="28" Padding="8,0" Margin="6,0,0,0" Click="RemoveSheet_Click"/>
                    </StackPanel>
                    <ListBox x:Name="SheetList"
                             SelectionChanged="SheetList_SelectionChanged"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- 右：规则编辑 -->
            <Border Grid.Column="2" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="RuleEditorPanel" IsEnabled="False">
                        <TextBlock x:Name="RuleTitle" Text="选择左侧 Sheet 以编辑规则"
                                   FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="输出文件" VerticalAlignment="Center"/>
                            <TextBox x:Name="OutputNameBox" Grid.Column="1" Height="28" Margin="0,0,8,6"/>
                            <TextBlock Grid.Column="2" Text="KeyColumn" VerticalAlignment="Center"/>
                            <TextBox x:Name="KeyColumnBox" Grid.Column="3" Height="28" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Text="行起" VerticalAlignment="Center"/>
                            <TextBox x:Name="RowStartBox" Grid.Row="1" Grid.Column="1" Height="28" Margin="0,0,8,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="行止" VerticalAlignment="Center"/>
                            <TextBox x:Name="RowEndBox" Grid.Row="1" Grid.Column="3" Height="28" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Text="列起" VerticalAlignment="Center"/>
                            <TextBox x:Name="ColStartBox" Grid.Row="2" Grid.Column="1" Height="28" Margin="0,0,8,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="列止" VerticalAlignment="Center"/>
                            <TextBox x:Name="ColEndBox" Grid.Row="2" Grid.Column="3" Height="28" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="3" Text="跳过列" VerticalAlignment="Center"/>
                            <TextBox x:Name="ExcludeColsBox" Grid.Row="3" Grid.Column="1" Height="28" Margin="0,0,8,6"
                                     ToolTip="逗号分隔，如 G,H"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="数组字段" VerticalAlignment="Center"/>
                            <TextBox x:Name="ArrayFieldsBox" Grid.Row="3" Grid.Column="3" Height="28" Margin="0,0,0,6"
                                     ToolTip="逗号分隔"/>

                            <TextBlock Grid.Row="4" Text="取整字段" VerticalAlignment="Center"/>
                            <TextBox x:Name="RoundFieldsBox" Grid.Row="4" Grid.Column="1" Height="28" Margin="0,0,8,6"
                                     ToolTip="* 表示全部，或逗号分隔字段名"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="输出模式" VerticalAlignment="Center"/>
                            <ComboBox x:Name="NoKeyModeBox" Grid.Row="4" Grid.Column="3" Height="28" Margin="0,0,0,6">
                                <ComboBoxItem Content="Array" Tag="Array"/>
                                <ComboBoxItem Content="RowIndexObject" Tag="RowIndexObject"/>
                            </ComboBox>

                            <CheckBox x:Name="RemoveEmptyBox" Grid.Row="5" Grid.Column="1"
                                      Content="移除空字段" Margin="0,0,0,8" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="表头映射（列字母 → 字段名）" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <DataGrid x:Name="HeadersGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  Height="120"
                                  Margin="0,0,0,8"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="列字母" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                <DataGridTextColumn Header="字段名" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="计算列（字段名 → 表达式）" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <TextBlock Text="示例: spiritType * 100 + level" Foreground="#6B7280" FontSize="11" Margin="0,0,0,4"/>
                        <DataGrid x:Name="ComputedGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  Height="90"
                                  Margin="0,0,0,8"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="字段名" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                <DataGridTextColumn Header="表达式" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="子表 SubTables" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="添加子表" Height="26" Padding="8,0" Click="AddSubTable_Click"/>
                                <Button Content="删除子表" Height="26" Padding="8,0" Margin="6,0,0,0" Click="RemoveSubTable_Click"/>
                            </StackPanel>
                            <ListBox x:Name="SubTableList" Height="80" SelectionChanged="SubTableList_SelectionChanged"/>
                        </DockPanel>

                        <Border x:Name="SubTableEditor" BorderBrush="#E5E7EB" BorderThickness="1"
                                Padding="8" CornerRadius="4" IsEnabled="False">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="子表 Key" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SubKeyBox" Grid.Column="1" Height="26" Margin="0,0,8,4"
                                             LostFocus="SubKeyBox_LostFocus"/>
                                    <TextBlock Grid.Column="2" Text="输出文件" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SubOutputBox" Grid.Column="3" Height="26" Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="1" Text="行起/止" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,4">
                                        <TextBox x:Name="SubRowStartBox" Width="60" Height="26"/>
                                        <TextBlock Text=" - " VerticalAlignment="Center"/>
                                        <TextBox x:Name="SubRowEndBox" Width="60" Height="26"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="列起/止" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBox x:Name="SubColStartBox" Width="50" Height="26"/>
                                        <TextBlock Text=" - " VerticalAlignment="Center"/>
                                        <TextBox x:Name="SubColEndBox" Width="50" Height="26"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Text="跳过列" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SubExcludeBox" Grid.Row="2" Grid.Column="1" Height="26" Margin="0,0,8,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="数组字段" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SubArrayBox" Grid.Row="2" Grid.Column="3" Height="26" Margin="0,0,0,4"/>

                                    <TextBlock Grid.Row="3" Text="取整字段" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SubRoundBox" Grid.Row="3" Grid.Column="1" Height="26" Margin="0,0,8,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="输出模式" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="SubNoKeyModeBox" Grid.Row="3" Grid.Column="3" Height="26" Margin="0,0,0,4">
                                        <ComboBoxItem Content="Array" Tag="Array"/>
                                        <ComboBoxItem Content="RowIndexObject" Tag="RowIndexObject"/>
                                    </ComboBox>

                                    <CheckBox x:Name="SubWrapBox" Grid.Row="4" Grid.Column="1" Content="WrapWithSubKey" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="SubRemoveEmptyBox" Grid.Row="4" Grid.Column="3" Content="移除空字段" Margin="0,0,0,4"/>
                                </Grid>

                                <TextBlock Text="子表头映射" Margin="0,4,0,2"/>
                                <DataGrid x:Name="SubHeadersGrid" AutoGenerateColumns="False" CanUserAddRows="True"
                                          CanUserDeleteRows="True" Height="80" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="列字母" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                        <DataGridTextColumn Header="字段名" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="子表计算列" Margin="0,6,0,2"/>
                                <DataGrid x:Name="SubComputedGrid" AutoGenerateColumns="False" CanUserAddRows="True"
                                          CanUserDeleteRows="True" Height="70" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="字段名" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                        <DataGridTextColumn Header="表达式" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="Transparent"/>

        <Border Grid.Row="4" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Background="White">
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                     BorderThickness="0" Padding="10" Background="Transparent"/>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,8,0,0" Foreground="#6B7280" Text="就绪"/>
    </Grid>
</Window>
